# Run one API worker. No cloud services or credentials are required.
DATABASE_URL=sqlite:///./data/smartbilliard.db
DECISION_CONFIG=configs/decision.toml
AUTO_OPEN_ENABLED=false
SIMULATION_ENABLED=true
TABLE_COUNT=4
HOURLY_RATE_VND=60000
DISPLAY_TIMEZONE=Asia/Ho_Chi_Minh
# Reserved for Phase 3: these do not start a camera in Phase 2.
CAMERA_ID=cam-01
CAMERA_SOURCE=0
VISION_MODE=REAL_CLUB
